{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LX Remote",
  "version": "0.1.0",
  "identifier": "app.lxmusic.remote",
  "build": {
    "frontendDist": "../ui"
},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LX Remote",
        "width": 380,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true,
        "center": false,
        "x": null,
        "y": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src http: https: ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}